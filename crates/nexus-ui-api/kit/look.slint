import { Vm } from "../types.slint";
import { Tokens } from "../tokens.slint";

// Values the kit's widgets and every theme's screens share. The kit lays everything out on a
// 1920×1080 canvas; `k` maps that canvas to the window, so a size here is `N * Look.k` for N px
// at 1080p.
export global Look {
    out property <bool> rtl: Tokens.layout-direction == "rtl";
    // The window's own height, which the shell sets as soon as the window has one: the host's
    // `Vm.viewport` comes with the first render, so the first frame would be drawn at the
    // smallest scale without it.
    in-out property <length> window-height;
    // The player's "Size of everything" multiplies it. It is 0 until the first render.
    out property <float> size: Vm.viewport.size > 0 ? Vm.viewport.size : 1;
    out property <float> k: Math.max(root.window-height > 0 ? root.window-height : Vm.viewport.height, 360px) / 1080px * root.size;
    // Text that must stay readable (Settings) never scales below 0.75.
    out property <float> t: Math.max(root.k, 0.75);
    out property <length> px: 1px * root.k;
    out property <length> tpx: 1px * root.t;

    // How long a new game's hero and art wait for its details before they come in without.
    out property <duration> wait-for-details: 450ms;
    // How long after the last move in the Home row or a grid the core hears of the selection.
    // Not an animation: it stays with Animations off.
    out property <duration> select-after: 100ms;

    // Colors the kit's widgets share, drawn from the tokens.
    out property <color> text3: Tokens.color-text-faint;
    out property <color> line: Tokens.color-tint.with-alpha(0.11);
    // A button on a dark band, and the same button under the keys.
    out property <color> fill: Tokens.color-tint.with-alpha(0.078);
    out property <color> fill-lit: Tokens.color-tint.with-alpha(0.149);
    out property <color> glow: Tokens.color-accent.with-alpha(0.549);
    out property <color> ring: Tokens.color-focus;
    out property <color> ink: Tokens.color-on-focus;
    // The Library's header band, and the fades at the edges of the genre row over it.
    out property <color> band: Tokens.color-bg;
    out property <color> band-clear: Tokens.color-bg.with-alpha(0);
    out property <duration> move: Tokens.motion-normal > 0 ? 240ms : 0ms;
    // A fixed animation time: `time` with Animations on, 0 with Animations off, as the
    // motion tokens.
    public pure function timed(time: duration) -> duration { Tokens.motion-normal > 0 ? time : 0ms }

    // A compatibility level's color: in-game and playable green, menus yellow, boots
    // orange, nothing red, unknown grey.
    public pure function compat-color(level: string) -> color {
        level == "playable" || level == "ingame" ? Tokens.color-success
            : level == "menus" ? Tokens.color-caution
            : level == "boots" ? Tokens.color-warning
            : level == "nothing" ? Tokens.color-danger
            : Tokens.color-text-faint
    }
    // An emulator download's state from the core, in the player's words.
    public pure function job-state-label(state: string) -> string {
        state == "queued" ? "Waiting" : state == "downloading" ? "Downloading" : state == "verifying" ? "Checking"
            : state == "unpacking" ? "Unpacking" : state == "paused" ? "Paused" : state == "installing" ? "Installing"
            : state == "done" ? "Done" : state == "failed" ? "Failed" : state == "cancelled" ? "Cancelled" : state
    }
    // A compatibility layer's rating as words and as a color: green runs well, red doesn't run.
    // It knows ProtonDB's tiers; another word shows as it is, in grey.
    public pure function rating-label(tier: string) -> string {
        tier == "platinum" ? "Platinum" : tier == "gold" ? "Gold" : tier == "silver" ? "Silver"
            : tier == "bronze" ? "Bronze" : tier == "borked" ? "Borked" : tier == "native" ? "Native"
            : tier == "pending" ? "Pending" : tier
    }
    public pure function rating-color(tier: string) -> color {
        tier == "platinum" || tier == "gold" || tier == "native" ? Tokens.color-success
            : tier == "borked" ? Tokens.color-danger
            : tier == "silver" || tier == "bronze" ? Tokens.color-warning
            : Tokens.color-text-faint
    }
    // How a game runs on this PC as a color: green runs well, orange may run slowly, red
    // won't start or doesn't fit.
    public pure function pc-color(level: string) -> color {
        level == "good" ? Tokens.color-success
            : level == "slow" ? Tokens.color-warning
            : level == "no" ? Tokens.color-danger
            : Tokens.color-text-faint
    }
    // A badge tone's color.
    public pure function tone(tone: string) -> color {
        tone == "success" ? Tokens.color-success
            : tone == "warning" ? Tokens.color-warning
            : tone == "danger" ? Tokens.color-danger
            : tone == "info" ? Tokens.color-info
            : Tokens.color-text-muted
    }
    // A system's look comes from the one color its plugin gives (`system-color`), so any
    // plugin's games have their own without a change here. Transparent: the neutral look.
    // The system's color made dark at `value` (0 to 1), its hue kept and richer: a pale color
    // mixed with black only greys.
    pure function deep(system: color, value: float) -> color {
        hsv(system.to-hsv().hue, Math.min(1, system.to-hsv().saturation + 0.3), value)
    }
    // The art a game without a cover shows: its system's color, deep.
    public pure function console-art(system: color) -> brush {
        system.alpha == 0 ? @linear-gradient(160deg, Tokens.color-surface-raised 0%, Tokens.color-panel 100%)
            : @linear-gradient(160deg, deep(system, 0.3) 0%, deep(system, 0.12) 100%)
    }
    // A card's system badge, big enough to tell systems apart at a glance: a dark fill, an edge
    // and text in the system's color.
    public pure function console-fill(system: color) -> color {
        system.alpha == 0 ? Tokens.color-shade.with-alpha(0.851) : deep(system, 0.36).with-alpha(0.91)
    }
    public pure function console-edge(system: color) -> color {
        system.alpha == 0 ? Tokens.color-tint.with-alpha(0.349) : system.with-alpha(0.5)
    }
    public pure function console-ink(system: color) -> color {
        system.alpha == 0 ? Tokens.color-tint : system.mix(Tokens.color-tint, 0.75)
    }
    // How easy a release is to download, as a color: good green, low amber, none or unknown
    // grey.
    public pure function availability-color(level: string) -> color {
        level == "good" ? Tokens.color-success : level == "low" ? Tokens.color-warning : root.text3
    }
    // A system's full name, as its plugin gives it (`system-name`); "" is every system.
    public pure function system-name(name: string) -> string {
        name == "" ? "All Games" : name
    }
    // The player's own result after playing, as words and as a color.
    public pure function result-label(level: string) -> string {
        level == "ingame" ? "Reaches gameplay" : level == "menus" ? "Main menu" : level == "boots" ? "Intro logos" : level == "nothing" ? "Doesn't start" : ""
    }
    public pure function result-color(level: string) -> color {
        level == "ingame" ? Tokens.color-success : level == "menus" ? Tokens.color-caution : level == "boots" ? Tokens.color-warning : Tokens.color-danger
    }
    // "Shooter · Arcade": the first two, for the genre chip.
    public pure function join(items: [string]) -> string {
        items.length == 0 ? "" : items.length == 1 ? items[0] : items[0] + " · " + items[1]
    }
    // What the Library's and the Catalog's sort button says.
    public pure function sort-label(sort: string) -> string {
        sort == "played" ? "Recently played" : sort == "size" ? "Size (largest first)"
            : sort == "smallest" ? "Size (smallest first)" : sort == "rating" ? "Top rated"
            : sort == "release" ? "Newest" : sort == "compat" ? "Runs best" : sort == "added" ? "Recently added" : "Title"
    }
    public pure function games(count: int) -> string {
        count == 1 ? "1 game" : count + " games"
    }
    public pure function releases(count: int) -> string {
        count == 1 ? "1 release" : count + " releases"
    }
    // A theme option's choice, in words.
    public pure function choice(value: string) -> string {
        value == "ltr" ? "Left to right"
            : value == "rtl" ? "Right to left"
            : value == "on" ? "On"
            : value == "off" ? "Off"
            : value == "true" ? "On"
            : value == "false" ? "Off"
            : value
    }
}
