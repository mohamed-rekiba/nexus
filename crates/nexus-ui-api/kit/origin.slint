// The card the Game Hub opens from, for its cover to grow out of it. `from` is "row" for Home's
// selected tile, "grid" for the Library's or the Catalog's card at `x`, `y` (on screen),
// `width` and `height`, or "" when the place isn't known: the cover then fades in. The Game
// Hub reads it as it opens, and sets `from` back to "".
export global Origin {
    in-out property <string> from;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    // The selected grid card's place, kept by the grid on screen.
    in-out property <length> card-x;
    in-out property <length> card-y;
    in-out property <length> card-width;
    in-out property <length> card-height;
    // The Game Hub opens from the selected grid card.
    public function from-grid() {
        root.from = "grid";
        root.x = root.card-x;
        root.y = root.card-y;
        root.width = root.card-width;
        root.height = root.card-height;
    }
}
