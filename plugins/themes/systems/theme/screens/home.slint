import { Vm, Host } from "../types.slint";
import { Tokens } from "../tokens.slint";
import { Assets } from "../assets.slint";
import { Look } from "../components/look.slint";
import { Nav } from "../components/nav.slint";
import { FocusRing, Cover } from "../components/widgets.slint";
import { LibraryView } from "../components/library-view.slint";

// The Systems theme's Home: a column of systems on the far side of the reading direction, "All
// games" first, then each emulator in `Vm.emulators`. The focused system's cover fills the
// screen behind it. Enter or a click opens the Library on the system's games (`Nav`); the
// Library is the default theme's.
component SystemsView inherits Rectangle {
    // The tiles: the focused one big, the others small, as the default Home's row.
    property <length> big: 150 * Look.px;
    property <length> small: 96 * Look.px;
    property <length> gap: 18 * Look.px;
    // From the window's far edge to the tiles.
    property <length> edge: 96 * Look.px;
    property <length> top: 150 * Look.px;
    property <bool> keys: Nav.zone == "row";

    // Each entry's pictures and words: 0 is All games, `i` is `Vm.emulators[i - 1]`.
    pure function icon-of(i: int) -> image {
        i == 0 ? Assets.all-games-icon : Vm.emulators[i - 1].icon
    }
    pure function cover-of(i: int) -> image {
        i == 0 ? Assets.all-games-cover : Vm.emulators[i - 1].cover
    }
    pure function title-of(i: int) -> string {
        i == 0 ? "All games"
            : Vm.emulators[i - 1].system-name != "" ? Vm.emulators[i - 1].system-name
            : Vm.emulators[i - 1].name
    }
    pure function system-of(i: int) -> string {
        i == 0 ? "all" : Vm.emulators[i - 1].system
    }
    // A tag under the name: the game running, an emulator that didn't load, or one to install.
    pure function tag-of(i: int) -> string {
        i == 0 ? ""
            : Vm.has-running && Vm.running.emulator == Vm.emulators[i - 1].name ? "● PLAYING"
            : Vm.emulators[i - 1].status == "failed" ? "Didn't load"
            : Vm.emulators[i - 1].has-builds && Vm.emulators[i - 1].installed.length == 0 ? "Not installed"
            : ""
    }
    pure function tag-color(i: int) -> color {
        root.tag-of(i) == "● PLAYING" ? Tokens.color-success
            : root.tag-of(i) == "Didn't load" ? Tokens.color-danger
            : Tokens.color-text-muted
    }

    // Where entry `i` starts, from the top of the list, before the scroll.
    pure function at-y(i: int) -> length {
        i <= Nav.entry ? i * (root.small + root.gap)
            : Nav.entry * (root.small + root.gap) + root.big + root.gap + (i - Nav.entry - 1) * (root.small + root.gap)
    }
    // The list moves up so the focused tile stays on screen, over the hints at the bottom.
    property <length> scroll: Math.max(0, root.at-y(Nav.entry) + root.big - (root.height - root.top - 150 * Look.px));

    // The cover follows the focus a moment after the last move, so a held key doesn't flash
    // each one. Two layers take turns, the new one fading in over the old.
    property <int> layer-a: 0;
    property <int> layer-b: 0;
    property <bool> front-b;
    property <int> shown: 0;
    changed entry => { root.waiting = true; }
    property <int> entry: Nav.entry;
    property <bool> waiting;
    Timer {
        interval: 150ms;
        running: root.waiting;
        triggered => {
            root.waiting = false;
            if (Nav.entry == root.shown) { return; }
            if (root.front-b) { root.layer-a = Nav.entry; } else { root.layer-b = Nav.entry; }
            root.front-b = !root.front-b;
            root.shown = Nav.entry;
        }
    }

    background: Tokens.color-bg;
    for layer in [0, 1] : Image {
        property <bool> front: (layer == 1) == root.front-b;
        width: parent.width;
        height: parent.height;
        source: root.cover-of(layer == 0 ? root.layer-a : root.layer-b);
        image-fit: cover;
        opacity: self.front ? 1 : 0;
        animate opacity { duration: Look.timed(Tokens.motion-slow); easing: ease-out-quad; }
    }
    // The cover the screen shows, for tests and screen readers: the system's id, "all" for All
    // games.
    Rectangle {
        accessible-role: text;
        accessible-label: "systems-background";
        accessible-value: root.system-of(root.shown);
    }
    // Dark behind the list and under the top bar, so both read on any cover.
    if !Look.rtl : Rectangle { background: @linear-gradient(270deg, #05070ff5 0%, #05070fd8 30%, #05070f70 55%, #05070f00 78%); }
    if Look.rtl : Rectangle { background: @linear-gradient(90deg, #05070ff5 0%, #05070fd8 30%, #05070f70 55%, #05070f00 78%); }
    Rectangle { background: @linear-gradient(180deg, #05070fcc 0%, #05070f00 18%); }

    list := Rectangle {
        y: root.top;
        height: root.height - root.top;
        // The mouse wheel moves along the list, an entry a notch. Under the tiles, so their
        // clicks stay theirs.
        TouchArea {
            scroll-event(event) => {
                let delta = (event.delta-y + event.delta-x) / 1px;
                if (Math.abs(delta) < 1) { return reject; }
                Nav.step-row(delta > 0 ? -1 : 1);
                Nav.zone = "row";
                accept
            }
        }
        for i in Nav.entries : row := Rectangle {
            property <bool> focused: i == Nav.entry;
            property <length> size: self.focused ? root.big : root.small;
            // The tile's place from the far edge: right to left, the list is on the left.
            property <length> tile-x: Look.rtl ? root.edge : root.width - root.edge - self.size;
            y: root.at-y(i) - root.scroll;
            height: self.size;
            visible: self.y + self.height > 0 && self.y < parent.height;
            animate y, height { duration: Look.timed(Tokens.motion-slow - 60ms); easing: ease-out-expo; }

            tile := Rectangle {
                x: row.tile-x;
                width: row.size;
                height: row.size;
                accessible-role: button;
                accessible-label: "systems-tile";
                accessible-value: root.title-of(i);
                accessible-item-selected: row.focused;
                accessible-action-default => { Nav.entry = i; Nav.open-entry(); }
                opacity: root.tag-of(i) == "Not installed" && !row.focused ? 0.6 : 1;
                animate x, width, height { duration: Look.timed(Tokens.motion-slow - 60ms); easing: ease-out-expo; }
                FocusRing { w: parent.width; h: parent.height; on: (row.focused && root.keys) || touch.has-hover; radius: 18 * Look.px; }
                Cover {
                    radius: 18 * Look.px;
                    source: root.icon-of(i);
                    state: "";
                    title: root.title-of(i);
                    system-color: transparent;
                    name-size: parent.width * 0.14;
                }
                // The running game's system: a green frame, as the default Home's tile.
                if root.tag-of(i) == "● PLAYING" : Rectangle {
                    border-radius: 18 * Look.px;
                    border-width: 3 * Look.px;
                    border-color: Tokens.color-success;
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    // One click opens the system, focused or not.
                    clicked => {
                        Nav.entry = i;
                        Nav.zone = "row";
                        Nav.open-entry();
                    }
                }
            }
            // The name, on the near side of the tile.
            VerticalLayout {
                x: Look.rtl ? row.tile-x + row.size + 24 * Look.px : row.tile-x - self.width - 24 * Look.px;
                width: 460 * Look.px;
                alignment: center;
                spacing: 4 * Look.px;
                Text {
                    text: root.title-of(i);
                    font-size: (row.focused ? 32 : 22) * Look.px;
                    font-weight: row.focused ? 600 : 500;
                    color: row.focused ? Tokens.color-text : Tokens.color-text-muted;
                    overflow: elide;
                    horizontal-alignment: Look.rtl ? left : right;
                    animate color { duration: Look.timed(Tokens.motion-fast); }
                }
                if root.tag-of(i) != "" : Text {
                    text: root.tag-of(i);
                    font-size: 16 * Look.px;
                    font-weight: 700;
                    letter-spacing: 1 * Look.px;
                    color: root.tag-color(i);
                    horizontal-alignment: Look.rtl ? left : right;
                    accessible-role: text;
                    accessible-label: "systems-tag";
                    accessible-value: root.title-of(i) + ": " + self.text;
                }
            }
        }
    }
}

export component HomeScreen inherits Rectangle {
    SystemsView {
        opacity: Nav.view == "home" ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Look.timed(Tokens.motion-normal); easing: ease-out-quad; }
    }
    // Made each time the Library opens, so its cards come in again.
    if Nav.view == "library" : LibraryView {
        active: Vm.screen == "home";
        property <bool> shown;
        // After the first frame, so the entry animates from its start.
        Timer { interval: 16ms; running: !parent.shown; triggered => { parent.shown = true; } }
        opacity: self.shown ? 1 : 0;
        x: self.shown ? 0 : 40 * Look.px * (Look.rtl ? -1 : 1);
        animate opacity { duration: Look.timed(Tokens.motion-normal); easing: ease-out-quad; }
        animate x { duration: Look.timed(Tokens.motion-slow); easing: ease-out-expo; }
    }
}
