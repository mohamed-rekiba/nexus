import { Vm, Host } from "../types.slint";
import { Tokens } from "../tokens.slint";
import { Look } from "../components/look.slint";
import { Nav } from "../components/nav.slint";

// While a game starts: the game's art dimmed behind its icon, its name, "Starting with
// KytyPS5…" and a turning ring, until the game's window shows. Then it fades, and the home
// screen is under it with Resume and Stop. The icon springs in and the art settles from a slight
// zoom. Its motion runs only while it shows. Without a controller, it lists the emulator's
// keyboard keys when the emulator names them (`Splash.keys`).
export global Splash {
    // The splash shows the emulator's keys. Only without a controller: with one, the player
    // uses the pad, and the keyboard keys don't help. The keys are the game's, so the shell
    // takes them all but Escape (Back) and Ctrl+Q.
    out property <bool> keys: Vm.has-running && Vm.running.state == "starting" && Vm.pad-name == ""
        && Vm.running.keymap.length > 0;
}

export component RunningScreen inherits Rectangle {
    property <bool> on: Vm.has-running && Vm.running.state == "starting";
    opacity: root.on ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.on ? Look.timed(320ms) : Look.timed(Tokens.motion-slow + 200ms); easing: ease-out-quad; }
    background: #000000;
    // It takes the pointer while it shows.
    TouchArea { enabled: root.on; }

    Image {
        source: Vm.detail.background;
        width: root.width;
        height: root.height;
        image-fit: cover;
        opacity: 0.45;
        transform-scale: root.on ? 1.0 : 1.08;
        animate transform-scale { duration: root.on ? Look.timed(6s) : 0ms; easing: ease-out-quint; }
    }
    Rectangle { background: @radial-gradient(circle, #00000033 0%, #000000d9 75%); }
    VerticalLayout {
        alignment: center;
        spacing: 0;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 220 * Look.px;
                height: 220 * Look.px;
                border-radius: 28 * Look.px;
                clip: true;
                background: Tokens.color-surface;
                transform-scale: root.on ? 1.0 : 0.86;
                animate transform-scale { duration: Look.timed(600ms); easing: ease-out-back; }
                drop-shadow-blur: 40 * Look.px;
                drop-shadow-color: #00000099;
                Image { source: Nav.has-game ? Nav.games[Nav.shown].cover : Vm.detail.cover; width: parent.width; height: parent.height; image-fit: cover; }
            }
        }
        Rectangle { height: 34 * Look.px; }
        Text {
            text: Vm.running.title;
            font-size: 44 * Look.px;
            font-weight: 600;
            color: Tokens.color-text;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: root.on ? "launch-title" : "";
            accessible-value: self.text;
        }
        Rectangle { height: 10 * Look.px; }
        Text {
            text: Vm.running.emulator != "" ? "Starting with " + Vm.running.emulator + "…" : "Starting…";
            font-size: 20 * Look.px;
            color: Tokens.color-text-muted;
            horizontal-alignment: center;
        }
        // What the game gets: the controller, or the keyboard.
        if !Splash.keys : Text {
            text: Vm.pad-name != "" ? "Controller: " + Vm.pad-name : "Keyboard: the keys are on " + (Vm.running.page != "" ? "the " + Vm.running.page + " page" : "the emulator's page");
            font-size: 17 * Look.px;
            color: Look.text3;
            horizontal-alignment: center;
            accessible-role: text;
            accessible-label: root.on ? "launch-input" : "";
            accessible-value: self.text;
        }
        // The emulator's keyboard keys, in two columns.
        if Splash.keys : HorizontalLayout {
            alignment: center;
            padding-top: 18 * Look.px;
            Rectangle {
                width: 760 * Look.px;
                height: Math.ceil(Vm.running.keymap.length / 2) * 34 * Look.px + 56 * Look.px;
                border-radius: 18 * Look.px;
                background: #ffffff0d;
                border-width: 1px;
                border-color: Look.line;
                Text {
                    x: 0;
                    y: 14 * Look.px;
                    width: parent.width;
                    text: "Keyboard";
                    font-size: 15 * Look.px;
                    font-weight: 600;
                    color: Look.text3;
                    horizontal-alignment: center;
                }
                for key[i] in Vm.running.keymap : Rectangle {
                    // Right to left, the first column is on the right, and the button comes first
                    // from the right.
                    property <int> column: Math.mod(i, 2);
                    property <length> half: (parent.width - 72 * Look.px) / 2;
                    x: 24 * Look.px + (Look.rtl ? 1 - self.column : self.column) * (self.half + 24 * Look.px);
                    y: 44 * Look.px + Math.floor(i / 2) * 34 * Look.px;
                    width: self.half;
                    height: 30 * Look.px;
                    accessible-role: text;
                    accessible-label: root.on ? "launch-key" : "";
                    accessible-value: key.label + " " + key.value;
                    Text {
                        x: Look.rtl ? parent.width - self.width : 0;
                        width: parent.width * 0.5;
                        height: parent.height;
                        text: key.label;
                        font-size: 16 * Look.px;
                        color: Tokens.color-text-muted;
                        horizontal-alignment: Look.rtl ? right : left;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: Look.rtl ? 0 : parent.width * 0.52;
                        width: parent.width * 0.48;
                        height: parent.height;
                        text: key.value;
                        font-size: 16 * Look.px;
                        font-weight: 600;
                        color: Tokens.color-text;
                        horizontal-alignment: Look.rtl ? right : left;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        Rectangle { height: 36 * Look.px; }
        HorizontalLayout {
            alignment: center;
            Path {
                width: 44 * Look.px;
                height: 44 * Look.px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: Tokens.color-text;
                stroke-width: 2.5 * Look.px;
                commands: "M 12 3 A 9 9 0 1 1 3 12";
                transform-rotation: root.on ? animation-tick() / 1ms * 0.4deg : 0deg;
            }
        }
        Rectangle { height: 40 * Look.px; }
    }
}
