import { Vm, Host } from "../types.slint";
import { Tokens } from "../tokens.slint";
import { Look } from "../components/look.slint";
import { BackButton } from "../components/widgets.slint";
import { Prefs, Header, FieldRow } from "../components/settings-rows.slint";

// One game's own settings, from its emulator, as a side sheet like Settings: the rows and
// keys of every sheet (`Prefs`, section 0). Back returns to the Game Hub.
export component GameSettingsScreen inherits Rectangle {
    // False while it slides out.
    in property <bool> open: true;
    property <bool> entered;
    // Slint animates a change from a value it already worked out: read the start (off the
    // edge) now, then slide in after the first frame.
    property <length> start-x;
    property <float> start-opacity;
    init => {
        root.start-x = sheet-panel.x;
        root.start-opacity = sheet-panel.opacity;
    }
    Timer { interval: 16ms; running: !root.entered; triggered => { root.entered = true; } }
    property <bool> in-view: root.entered && root.open;
    background: root.in-view ? #03050ccc : #03050c00;
    animate background { duration: Tokens.motion-normal; }
    TouchArea { enabled: root.open; clicked => { Host.back(); } }

    // Keeps the focused row in view, as Settings does.
    function reveal(y: length, h: length) {
        let top = y - flick.absolute-position.y;
        let margin = 120 * Look.px;
        if (top + h > flick.height - margin) {
            flick.viewport-y = Math.max(flick.height - flick.viewport-height, flick.viewport-y - (top + h - flick.height + margin));
        } else if (top < margin) {
            flick.viewport-y = Math.min(0, flick.viewport-y + (margin - top));
        }
    }

    sheet-panel := Rectangle {
        property <length> panel-width: Math.min(root.width, 760 * Look.tpx);
        x: (Look.rtl ? 0 : root.width - self.panel-width)
            + (root.in-view ? 0 : (Look.rtl ? -1 : 1) * (self.panel-width + 48 * Look.px));
        opacity: root.in-view ? 1 : 0;
        animate x { duration: Tokens.motion-slow; easing: ease-out-expo; }
        animate opacity { duration: Look.timed(Tokens.motion-normal - 40ms); easing: ease-out-quad; }
        width: self.panel-width;
        background: @linear-gradient(180deg, #111a33 0%, #0a1024 100%);
        border-width: 1px;
        border-color: Look.line;
        TouchArea {}

        flick := Flickable {
            // Up and down only: nothing drags sideways.
            viewport-width: self.width;
            viewport-height: sheet.preferred-height;
            animate viewport-y { duration: Tokens.motion-normal; easing: ease-out-quad; }

            sheet := VerticalLayout {
                width: parent.width;
                padding-left: 56 * Look.px;
                padding-right: 56 * Look.px;
                padding-top: 64 * Look.px;
                padding-bottom: 120 * Look.px;
                spacing: 0;

                HorizontalLayout {
                    alignment: Look.rtl ? end : start;
                    padding-bottom: 20 * Look.px;
                    BackButton { pad: Vm.input-mode == "gamepad"; clicked => { Host.back(); } }
                }
                Text {
                    text: Vm.detail.title;
                    font-size: 44 * Look.px;
                    font-weight: 600;
                    color: Tokens.color-text;
                    wrap: word-wrap;
                    horizontal-alignment: Look.rtl ? right : left;
                    accessible-role: text;
                    accessible-label: "game-settings-title";
                    accessible-value: self.text;
                }
                Text {
                    text: Vm.detail.settings.length > 0 ? Vm.detail.settings[0].slot.text : "";
                    font-size: 18 * Look.tpx;
                    color: Look.text3;
                    horizontal-alignment: Look.rtl ? right : left;
                }
                for panel[p] in Vm.detail.settings : VerticalLayout {
                    Header { text: "THIS GAME"; }
                    for field[i] in panel.fields : FieldRow {
                        field: field;
                        section: 0;
                        index: i;
                        first: i == 0;
                        last: i == panel.fields.length - 1;
                        reveal(y, h) => { root.reveal(y, h); }
                        set(value) => { Host.set-setting(panel.slot.plugin, panel.slot.scope, field.key, value); }
                    }
                }
            }
        }
    }
}
