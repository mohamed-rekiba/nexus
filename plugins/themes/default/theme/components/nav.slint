import { Vm, Host, GameCard, Library } from "../types.slint";
import { Commands } from "../commands.slint";
import { Look } from "look.slint";
import { GameMenu } from "game-menu.slint";
import { Sys } from "system-panel.slint";

// The card the Game Hub opens from, for its cover to grow out of it. `from` is "row" for Home's
// selected tile, "grid" for the Library's or the Catalog's card at `x`, `y` (on screen),
// `width` and `height`, or "" when the place isn't known: the cover then fades in. The Game
// Hub reads it as it opens, and sets `from` back to "".
export global Origin {
    in-out property <string> from;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    // The selected grid card's place, kept by the grid on screen.
    in-out property <length> card-x;
    in-out property <length> card-y;
    in-out property <length> card-width;
    in-out property <length> card-height;
    // The Game Hub opens from the selected grid card.
    public function from-grid() {
        root.from = "grid";
        root.x = root.card-x;
        root.y = root.card-y;
        root.width = root.card-width;
        root.height = root.card-height;
    }
}

// The Default theme's copy of the Classic theme's Nav. Home is a list of systems: "All games"
// (entry 0), then each emulator in `Vm.emulators` (entry 1 on). The keys act on one zone at a
// time: the top bar (`tabs`), the list (`row`), and in the Library its systems in the top bar
// (`filters`), its bar (`bar`: search, sort, the genres' list, and in the Catalog the catalog
// plugin's button) and its grid (`grid`). The Library has one card size.
//
// The top bar has no tabs: the five screen buttons (0 to 4), then, when Nexus is the whole
// screen, the network, sound and Bluetooth icons (5 to 7). A system opens the Library on its
// games (LibrarySystem); whatever brings the list back clears the filter. `extra` is true while
// the list shows, so the shell's game keys (Menu, T) stay off it. The list has no buttons under
// a game: the `actions` zone the shell gives a game that starts is the list's. Every other
// member is the Classic theme's, for the Classic theme's files that read them.
export global Nav {
    // home | library
    in-out property <string> view: "home";
    in-out property <string> zone: "row";
    in-out property <int> tab;
    in-out property <int> action;
    // The list shows: no game is on screen.
    in-out property <bool> extra: true;
    // The list's focused entry: 0 is All games, `i` is `Vm.emulators[i - 1]`. It stays when
    // the Library opens, so Back comes back to it.
    in-out property <int> entry;
    out property <int> entries: Vm.emulators.length + 1;
    // The system the focused entry opens: "" for All games, as LibrarySystem takes it.
    out property <string> entry-system: root.system-of(root.entry);
    // Entry `i`'s system: "" for All games.
    public pure function system-of(i: int) -> string {
        i > 0 && i <= Vm.emulators.length ? Vm.emulators[i - 1].system : ""
    }
    // The Library grid's columns, set by the grid.
    in-out property <int> columns: 1;
    // The focused item of the Library's bar and systems.
    in-out property <int> bar;
    in-out property <int> filter;
    // The system whose games the Library shows: "" for every system. Its cover is behind it.
    // Only `filter-library` sets it, with the core's filter: the core changes that filter only
    // when told to.
    out property <string> lib-system;
    // The search box has the keys, for typing; the shell takes them back when it's false.
    in-out property <bool> typing;
    // A letter typed in the Library grid, for the search box to start with.
    in-out property <string> first-letter;
    // A list under the bar is open, with the keys on `sort-focus`: the sorts, or the genres
    // when `picking-genre` is true.
    in-out property <bool> sort-open;
    in-out property <int> sort-focus;
    in-out property <bool> picking-genre;
    // How far each grid is scrolled. A screen's grid goes when a game's details open; the next
    // one starts where it was.
    in-out property <length> catalog-scroll;
    in-out property <length> library-scroll;
    // A card's Download opened the game's Hub: the keys go to its releases there.
    in-out property <bool> to-releases;

    out property <int> tabs: 0;
    // The screen buttons, then the network, sound and Bluetooth icons when Nexus is the whole
    // screen (`Sys`).
    out property <int> buttons: 5 + root.statuses;
    out property <int> statuses: Vm.system.whole-screen ? 3 : 0;
    out property <bool> library: root.view == "library";
    // The Catalog screen is open: the keys are on its view.
    out property <bool> catalog: Vm.screen == "catalog";
    // The Library's view, or the Catalog's.
    out property <Library> lib: root.catalog ? Vm.catalog : Vm.home.library;
    // The sorts of the view on screen. The Catalog starts with Recently added.
    out property <[string]> sorts: root.catalog ? ["added", "title", "size", "smallest", "rating", "release", "compat"]
        : ["title", "played", "size", "rating", "release", "compat"];
    out property <[GameCard]> games: root.catalog || root.library ? root.lib.games : Vm.home.games;
    // The core's selection: an index into `games`, or -1 when the selected game isn't in them.
    out property <int> core-selected: root.catalog || root.library ? root.lib.selected : Vm.home.selected;
    out property <string> core-key: root.core-selected >= 0 && root.core-selected < root.games.length
        ? root.games[root.core-selected].key : "";
    // The theme's own selection. A key move shows at once: the focus ring, the card's scale
    // and the hero follow `cursor`, and the core hears of it `Look.select-after` after the last
    // move (the shell's timer calls `send`). `moving` is true from the move until the core has
    // the same game; when the core's selection changes for another reason, the cursor follows
    // the core again (`core-moved`).
    in-out property <int> cursor: -1;
    in-out property <string> cursor-key;
    in-out property <bool> moving;
    // The cursor went to the core, and the core hasn't answered yet; `sent-from` is the
    // core's game at that time.
    in-out property <bool> sent;
    in-out property <string> sent-from;
    // Counts the moves: the shell's timer starts again on each.
    in-out property <int> moves;
    // The cursor still points at its game: a new list of games makes it stale.
    out property <bool> cursor-valid: root.moving && root.cursor >= 0 && root.cursor < root.games.length
        && root.games[root.cursor].key == root.cursor-key;
    // Index into `games`, or -1 when the selected game isn't in them.
    out property <int> selected: root.cursor-valid ? root.cursor : root.core-selected;
    // The selected game's key, or "" when none is.
    out property <string> selected-key: root.selected >= 0 && root.selected < root.games.length
        ? root.games[root.selected].key : "";
    // The game the screen shows: the selected one, or the first.
    out property <int> shown: Math.max(root.selected, 0);
    out property <bool> has-game: root.games.length > 0;
    // The shown game's details are loaded.
    out property <bool> has-detail: root.has-game && Vm.has-detail && Vm.detail.key == root.games[root.shown].key;
    // The shown game is the one running.
    out property <bool> playing: root.has-game && Vm.has-running && Vm.running.key == root.games[root.shown].key;
    // The buttons under the game: Resume, Stop and Game Hub while it runs; Play (when it can
    // start) and Game Hub otherwise; then the store page when there is one, and the game's
    // menu ("⋯") once its details are in.
    out property <bool> store: root.has-detail && Vm.detail.store-url != "";
    out property <int> hub-action: root.playing ? 2 : root.has-detail && Vm.detail.can.play ? 1 : 0;
    out property <int> store-action: root.hub-action + 1;
    out property <int> actions: root.hub-action + 1 + (root.store ? 1 : 0) + (root.has-detail ? 1 : 0);

    public pure function platform(entry: int) -> string {
        entry < 0 || entry >= Vm.home.groups.length ? "" : Vm.home.groups[entry].platform
    }
    public pure function count(entry: int) -> int {
        entry < 0 || entry >= Vm.home.groups.length ? Vm.home.games.length : Vm.home.groups[entry].games.length
    }

    // Opens the Library on every game, as All games does: the shell's search opens it.
    public function open-library() {
        root.entry = 0;
        root.open-entry();
    }
    // Opens the Library on the focused entry's games.
    public function open-entry() {
        root.filter-library(root.entry-system);
        root.sort-open = false;
        root.view = "library";
        root.zone = "grid";
        root.extra = false;
        Host.play-sound("select");
    }
    // The list comes back: from the Library, from the shell when a game starts, or before a
    // search. The Library's filter goes, so every other view of it starts from all the games.
    public function go-home() {
        if (root.view == "library") { root.filter-library(""); }
        root.sort-open = false;
        root.view = "home";
        root.zone = "row";
        root.extra = true;
    }
    // The focused entry's emulator page: its builds and settings. All games has none.
    public function open-entry-plugin() {
        if (root.entry == 0) { Host.play-sound("error"); return; }
        Host.play-sound("select");
        Commands.open-plugin(Vm.emulators[root.entry - 1].plugin);
    }
    // Up or down the list. Past the last entry it stops; up from the first goes to the top bar.
    public function step-list(delta: int) {
        let next = root.entry + delta;
        if (next < 0) {
            root.go("tabs");
            root.tab = root.first-tab;
        } else if (next >= root.entries) {
            Host.play-sound("error");
        } else {
            root.entry = next;
            Host.play-sound("move");
        }
    }
    // The top bar's first item the keys can reach: Search, or Downloads with no Catalog.
    out property <int> first-tab: Vm.catalog-available ? 0 : 1;
    public function activate-tab(index: int) {
        if (index >= root.tabs + 5) {
            Sys.show(index - root.tabs - 5);
        } else {
            Host.play-sound("select");
            Commands.navigate(index == 0 ? "catalog"
                : index == 1 ? "downloads"
                : index == 2 ? "emulators"
                : index == 3 ? "themes"
                : "settings");
        }
    }
    // The search, filters, sort and next page of the view on screen: the Catalog's or the
    // Library's.
    public function search(text: string) {
        if (root.catalog) { Commands.catalog-search(text); } else { Commands.library-search(text); }
    }
    public function system(id: string) {
        if (root.catalog) { Commands.catalog-system(id); } else { root.filter-library(id); }
    }
    // The Library shows the games of system `id` ("" for all), and its cover.
    function filter-library(id: string) {
        Commands.library-system(id);
        root.lib-system = id;
    }
    public function genre-filter(id: string) {
        if (root.catalog) { Commands.catalog-genre(id); } else { Commands.library-genre(id); }
    }
    public function more() {
        if (root.catalog) { Commands.catalog-more(); } else { Commands.library-more(); }
    }
    // The Catalog's bar has the catalog plugin's first button (`Vm.catalog-actions`), such as
    // Refresh, at its far end.
    out property <bool> bar-button: root.catalog && Vm.catalog-actions.length > 0;
    // The genres' button shows when there is a genre to pick.
    out property <bool> has-genres: root.lib.genres.length > 1;
    // The bar's items: search (0), sort (1), the genres (2), the Catalog's button (3).
    out property <int> bar-last: root.bar-button ? 3 : root.has-genres ? 2 : 1;
    public function activate-bar(index: int) {
        if (index == 0) {
            root.typing = true;
        } else if (index == 1) {
            // The list of sorts, with the keys on the one in use.
            root.picking-genre = false;
            root.sort-open = true;
            root.sort-focus = root.sort-index(root.lib.sort);
        } else if (index == 2 && root.has-genres) {
            // The list of genres: the one in use takes the keys as the list opens.
            root.picking-genre = true;
            root.sort-open = true;
            root.sort-focus = 0;
        } else if (index == 3 && root.bar-button) {
            let button = Vm.catalog-actions[0];
            Commands.run-action(button.plugin, button.action, "", button.args);
        }
        Host.play-sound("select");
    }
    // Where `sort` is in `sorts`.
    pure function sort-index(sort: string) -> int {
        root.catalog
            ? (sort == "title" ? 1 : sort == "size" ? 2 : sort == "smallest" ? 3 : sort == "rating" ? 4 : sort == "release" ? 5 : sort == "compat" ? 6 : 0)
            : (sort == "played" ? 1 : sort == "size" ? 2 : sort == "rating" ? 3 : sort == "release" ? 4 : sort == "compat" ? 5 : 0)
    }
    // The sort at `index` of `sorts`: the core sorts by it, and the list closes.
    public function pick-sort(index: int) {
        root.sort-open = false;
        if (root.catalog) { Commands.catalog-sort(root.sorts[index]); } else { Commands.library-sort(root.sorts[index]); }
        Host.play-sound("select");
    }
    // How many choices the open list has.
    out property <int> list-length: root.picking-genre ? root.lib.genres.length : root.sorts.length;
    // The genre at `index` of the genres: the core filters by it, and the list closes.
    public function pick-genre(index: int) {
        root.sort-open = false;
        root.genre-filter(root.lib.genres[index].id);
        Host.play-sound("select");
    }
    // The keys while a list under the bar is open: Up and Down move round it, Enter picks,
    // Back closes it. It takes every key.
    public function sort-key(text: string) {
        if ((text == Key.UpArrow || text == Key.DownArrow) && root.list-length > 0) {
            let count = root.list-length;
            root.sort-focus = Math.mod(root.sort-focus + (text == Key.DownArrow ? 1 : -1) + count, count);
            Host.play-sound("move");
        } else if (text == Key.Return) {
            if (root.sort-focus >= root.list-length) {
                root.sort-open = false;
            } else if (root.picking-genre) {
                root.pick-genre(root.sort-focus);
            } else {
                root.pick-sort(root.sort-focus);
            }
        } else if (text == Key.Escape || text == Key.Backspace) {
            root.sort-open = false;
            Host.play-sound("back");
        }
    }
    // A key move to the game at `index`: the cursor moves now, the core hears of it later.
    public function select(index: int) {
        if (root.games.length == 0) { return; }
        let at = Math.clamp(index, 0, root.games.length - 1);
        root.cursor = at;
        root.cursor-key = root.games[at].key;
        root.moving = true;
        root.sent = false;
        root.moves += 1;
        Host.play-sound("move");
    }
    // The cursor goes to the core now. The shell's timer calls it once the moves stop, and the
    // keys that act on the game call it first, so the core acts on the game on screen.
    public function send() {
        if (!root.moving || root.sent) { return; }
        if (!root.cursor-valid || root.cursor-key == root.core-key) {
            root.moving = false;
            return;
        }
        root.sent = true;
        root.sent-from = root.core-key;
        Commands.select(root.cursor-key);
    }
    // A click or the app selects `key`: at once, and a waiting key move is dropped.
    public function select-now(key: string) {
        root.moving = false;
        root.sent = false;
        Commands.select(key);
    }
    // The core's selection changed. It has the cursor's game, or it chose another after it
    // heard of the cursor (a refresh, a new list): either way the cursor follows the core. A
    // change from before the cursor went to the core doesn't count, and a move the core hasn't
    // heard of yet still goes to it.
    public function core-moved() {
        if (root.core-key == root.cursor-key || (root.sent && root.core-key != root.sent-from)) {
            root.moving = false;
            root.sent = false;
        }
    }
    // The mouse wheel on the list: an entry a notch, without the top bar.
    public function step-row(delta: int) {
        let next = Math.clamp(root.entry + delta, 0, root.entries - 1);
        if (next != root.entry) { root.entry = next; Host.play-sound("move"); }
    }
    // L1 and R1 on Home: the keys go to the top bar, and on to the item before or after the one
    // they were on, round the ends. The first press starts at the first item or the last.
    public function bar-step(delta: int) {
        root.send();
        if (root.zone != "tabs") {
            root.zone = "tabs";
            root.tab = delta > 0 ? root.first-tab - 1 : 0;
        }
        root.step-tab(delta);
    }
    public function step-tab(delta: int) {
        let next = root.tab + delta;
        // Search's place, with no Catalog: the next one on.
        let skipped = next == root.tabs && !Vm.catalog-available ? next + delta : next;
        // Round the ends: past the last item is the first.
        let count = root.tabs + root.buttons;
        root.tab = Math.mod(skipped + count, count);
        Host.play-sound("move");
    }
    // The button under the game at `action`.
    public function activate() {
        if (!root.has-game) { return; }
        let key = root.games[root.shown].key;
        if (root.has-detail && root.action == root.actions - 1) {
            GameMenu.show();
        } else if (root.store && root.action == root.store-action) {
            Host.open-url(Vm.detail.store-url);
        } else if (root.action == root.hub-action) {
            Host.play-sound("select");
            Origin.from = "row";
            Commands.open-game(key);
        } else if (root.playing) {
            if (root.action == 0) {
                Host.play-sound("select");
                Commands.show-game(Vm.running.session);
            } else {
                Host.play-sound("back");
                Commands.stop(Vm.running.session);
            }
        } else if (root.has-detail && Vm.detail.can.play) {
            Commands.launch(Vm.detail.key);
        }
    }

    // Handles a key on the home screen. Returns whether it did anything.
    public function key(text: string) -> bool {
        // A game that starts puts the keys on `actions`, which the list doesn't have.
        if (root.zone == "actions") { root.zone = "row"; }
        // A key that isn't a move acts on the game on screen: the core hears of it first.
        if (!(text == Key.LeftArrow || text == Key.RightArrow || text == Key.UpArrow || text == Key.DownArrow
            || text == Key.PageUp || text == Key.PageDown)) {
            root.send();
        }
        // The list is a column: left and right do nothing there.
        if (root.zone == "row" && (text == Key.LeftArrow || text == Key.RightArrow)) { return true; }
        // Left and right follow the reading direction.
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            if ((text == Key.RightArrow) == !Look.rtl) { return root.horizontal(1); }
            return root.horizontal(-1);
        }
        if (root.zone == "tabs") {
            if (text == Key.DownArrow) { root.go(root.library ? "filters" : "row"); return true; }
            if (text == Key.Return) { root.activate-tab(root.tab); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.go(root.view == "library" ? "grid" : "row"); return true; }
        } else if (root.zone == "row") {
            if (text == Key.UpArrow) { root.step-list(-1); return true; }
            if (text == Key.DownArrow) { root.step-list(1); return true; }
            if (text == Key.Return) { root.open-entry(); return true; }
            // Options on a pad, or the Menu key: the emulator's page.
            if (text == Key.Menu) { root.open-entry-plugin(); return true; }
        } else if (root.zone == "actions") {
            if (text == Key.UpArrow || text == Key.Escape || text == Key.Backspace) { root.go("row"); return true; }
            if (text == Key.Return) { root.activate(); return true; }
        } else if (root.catalog && (text == Key.Escape || text == Key.Backspace)) {
            // The Catalog is a screen of its own: back to where it opened from.
            Host.play-sound("back");
            Commands.back();
            return true;
        } else if (root.zone == "filters") {
            // The systems are in the top bar: up from them is the top bar's buttons.
            if (text == Key.UpArrow) { if (!root.catalog) { root.go("tabs"); root.tab = root.first-tab; } return true; }
            if (text == Key.DownArrow) { root.go("bar"); return true; }
            if (text == Key.Return) { root.system(root.lib.systems[root.filter].id); Host.play-sound("select"); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
        } else if (root.zone == "bar") {
            if (text == Key.UpArrow) { root.go("filters"); return true; }
            if (text == Key.DownArrow) { root.go("grid"); return true; }
            if (text == Key.Return) { root.activate-bar(root.bar); return true; }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
        } else if (root.zone == "grid") {
            if (text == Key.UpArrow) {
                if (root.selected < root.columns) { root.go("bar"); } else { root.select(root.selected - root.columns); }
                return true;
            }
            if (text == Key.DownArrow) {
                if (root.selected + root.columns < root.games.length) { root.select(root.selected < 0 ? 0 : root.selected + root.columns); }
                return true;
            }
            if (text == Key.Return) {
                if (root.has-game) {
                    Host.play-sound("select");
                    Origin.from-grid();
                    Commands.open-game(root.games[root.shown].key);
                }
                return true;
            }
            if (text == Key.Escape || text == Key.Backspace) { root.leave(); return true; }
            // L2 and R2, Page Up and Page Down: three lines at a time.
            if (text == Key.PageUp || text == Key.PageDown) {
                let step = root.columns * 3 * (text == Key.PageDown ? 1 : -1);
                root.select(Math.clamp(Math.max(root.selected, 0) + step, 0, root.games.length - 1));
                return true;
            }
            // Typing a letter or a digit searches.
            if (text.character-count == 1 && ((text >= "a" && text <= "z") || (text >= "A" && text <= "Z") || (text >= "0" && text <= "9"))) {
                root.first-letter = text;
                root.zone = "bar";
                root.bar = 0;
                root.typing = true;
                return true;
            }
        }
        false
    }
    // Back from the Library to the list, on the entry it opened from, with the back sound.
    public function leave() {
        root.go-home();
        Host.play-sound("back");
    }
    // Moves the keys to another zone, with the move sound.
    function go(zone: string) {
        root.send();
        root.zone = zone;
        Host.play-sound("move");
    }
    function horizontal(delta: int) -> bool {
        if (root.zone == "tabs") { root.step-tab(delta); }
        if (root.zone == "row") { root.step-row(delta); }
        if (root.zone == "actions") { root.action = Math.clamp(root.action + delta, 0, root.actions - 1); Host.play-sound("move"); }
        if (root.zone == "bar") {
            // With no genres, the genres' place is skipped.
            let next = root.bar + delta;
            root.bar = Math.clamp(next == 2 && !root.has-genres ? next + delta : next, 0, root.bar-last);
            Host.play-sound("move");
        }
        if (root.zone == "filters") { root.filter = Math.clamp(root.filter + delta, 0, root.lib.systems.length - 1); Host.play-sound("move"); }
        if (root.zone == "grid") { root.select(root.selected < 0 ? 0 : root.selected + delta); }
        true
    }
}
