// The old launcher's icons (assets/icons/*.svg), drawn as paths: a theme ships no SVG files.
export component Icon inherits Path {
    in property <string> name;
    in property <color> color: #ffffff;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.color;
    // The eyes' pupils are holes. The info and alert circles are rings in two halves with the
    // mark inside, not a disc with the mark cut out: the app's GPU renderer fills such holes in.
    fill-rule: root.name == "eye" || root.name == "eye-off" ? evenodd : nonzero;
    commands: root.name == "search" ? "M10.5 3a7.5 7.5 0 0 1 5.93 12.1l4.73 4.74-1.41 1.41-4.74-4.73A7.5 7.5 0 1 1 10.5 3zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11z"
