        : root.name == "check" ? "M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"
        : root.name == "close" ? "M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
        : root.name == "alert" ? "M12 2a10 10 0 0 0 0 20v-2a8 8 0 0 1 0-16zM12 2a10 10 0 0 1 0 20v-2a8 8 0 0 0 0-16zM11 7h2v7h-2zM11 16h2v2h-2z"
        : root.name == "chevl" ? "M15.4 7.4 14 6l-6 6 6 6 1.4-1.4-4.6-4.6z"
        : root.name == "chevr" ? "M8.6 16.6 10 18l6-6-6-6-1.4 1.4 4.6 4.6z"
        : root.name == "chevd" ? "M7.4 8.6 6 10l6 6 6-6-1.4-1.4-4.6 4.6z"
        : root.name == "star" ? "M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"
        : root.name == "film" ? "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v2h2V6H4zm14 0v2h2V6h-2zM4 10v4h2v-4H4zm14 0v4h2v-4h-2zM4 16v2h2v-2H4zm14 0v2h2v-2h-2zM8 6v12h8V6H8z"
        : root.name == "power" ? "M11 2h2v10h-2V2zm6.36 3.05 1.42-1.42A9.96 9.96 0 0 1 22 11c0 5.52-4.48 10-10 10S2 16.52 2 11c0-2.83 1.18-5.38 3.07-7.2l1.4 1.42A7.96 7.96 0 0 0 4 11a8 8 0 1 0 13.36-5.95z"
