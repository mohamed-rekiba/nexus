import { Tokens } from "../tokens.slint";
import { Look } from "../kit/look.slint";
import { LibraryView } from "../components/library-view.slint";

// The Library: every game in a grid, with its search, sort, systems and genres. It slides in
// from the side over Home.
export component LibraryScreen inherits Rectangle {
    property <bool> shown;
    // After the first frame, so the entry animates from its start.
    Timer { interval: 16ms; running: !root.shown; triggered => { root.shown = true; } }
    LibraryView {
        active: true;
        opacity: root.shown ? 1 : 0;
        x: root.shown ? 0 : 40 * Look.px * (Look.rtl ? -1 : 1);
        animate opacity { duration: Tokens.motion-normal; easing: ease-out-quad; }
        animate x { duration: Tokens.motion-slow; easing: ease-out-expo; }
    }
}
